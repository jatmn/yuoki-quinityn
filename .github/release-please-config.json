{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bootstrap-sha": "709646dbebdb6ff85a4de36929e5844d45d97eae",
  "packages": {
    ".": {
      "release-type": "simple",
      "versioning": "always-bump-patch",
      "version-file": ".github/version.txt",
      "changelog-path": "docs/CHANGELOG.md",
      "include-component-in-tag": false,
      "extra-files": [
        {"type": "json", "path": "info.json", "jsonpath": "$.version"}
      ],
      "changelog-sections": [
        {"type": "feat", "section": "Features", "hidden": false},
        {"type": "fix", "section": "Bug Fixes", "hidden": false},
        {"type": "perf", "section": "Performance", "hidden": false},
        {"type": "refactor", "section": "Refactoring", "hidden": false},
        {"type": "docs", "section": "Documentation", "hidden": false},
        {"type": "test", "section": "Tests", "hidden": false},
        {"type": "build", "section": "Build", "hidden": false},
        {"type": "ci", "section": "CI", "hidden": false},
        {"type": "chore", "section": "Maintenance", "hidden": false},
        {"type": "revert", "section": "Reverts", "hidden": false}
      ],
      "pull-request-footer": "Player-facing notes come from the Unreleased section maintained in normal PRs. The Release workflow finalizes their version and preparation date; wait for it and package checks before merging. Make note corrections in normal PRs, not on this generated branch. See docs/releases.md."
    }
  }
}
